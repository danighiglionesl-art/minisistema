# URL pública canónica
NEXT_PUBLIC_SITE_URL="https://www.minisistema.com.ar"

# Contactos oficiales iniciales (administrables desde /admin)
NEXT_PUBLIC_WHATSAPP_NUMBER="5493585095475"
NEXT_PUBLIC_WHATSAPP_URL="https://wa.me/5493585095475"
NEXT_PUBLIC_INSTAGRAM_URL="https://www.instagram.com/mini.sistema/"
NEXT_PUBLIC_FACEBOOK_URL="https://www.facebook.com/mini.sistema"

# Base de datos PostgreSQL administrada (Etapa 3 y 4)
DATABASE_URL="postgresql://usuario:password@host:5432/minisistema?sslmode=require"

# Autenticación del Panel Administrativo Privado (/admin)
# Generar ADMIN_PASSWORD_HASH con scrypt (nunca guardar contraseñas en texto plano)
ADMIN_AUTH_SECRET="reemplazar_con_secreto_hmac_256_seguro"
ADMIN_INITIAL_EMAIL="admin@minisistema.com.ar"
ADMIN_PASSWORD_HASH="scrypt:sal_hexadecimal:hash_derivado_hexadecimal"

# Notificaciones por correo (Opcional)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
NOTIFICATION_RECIPIENT_EMAIL=""
